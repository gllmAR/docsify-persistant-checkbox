{
  "name": "docsify-plugin-persistent-checkbox",
  "version": "1.0.0",
  "description": "Docsify 5 plugin: persistent, per-page checkbox state for task lists (exercises, self-validation, progress tracking). Vanilla JS, no build step.",
  "license": "MIT",
  "keywords": [
    "docsify",
    "docsify-plugin",
    "checkbox",
    "task-list",
    "progress",
    "localStorage",
    "vanilla-js"
  ],
  "main": "docsify-plugin-persistent-checkbox.js",
  "module": "esm.js",
  "unpkg": "docsify-plugin-persistent-checkbox.js",
  "jsdelivr": "docsify-plugin-persistent-checkbox.js",
  "exports": {
    ".": {
      "import": "./esm.js",
      "default": "./docsify-plugin-persistent-checkbox.js"
    },
    "./esm.js": "./esm.js",
    "./docsify-plugin-persistent-checkbox.js": "./docsify-plugin-persistent-checkbox.js"
  },
  "files": [
    "docsify-plugin-persistent-checkbox.js",
    "esm.js"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:serve": "npx -y docsify-cli serve ."
  },
  "devDependencies": {
    "docsify": "^5.0.0",
    "happy-dom": "^15.0.0",
    "marked": "^18.0.3",
    "vitest": "^3.0.0"
  }
}
